__pycache__/
*.pyc
.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local agent/tooling state — machine-specific, never deployed.
.claude/
.mcp.json
.trail/
.ignore
.superpowers/

# Cloudflare Worker tooling state
scheduler/.wrangler/
scheduler/node_modules/

# Local collector inputs — the DB-IP Lite archive is a 4.5 MB monthly download,
# regenerable and never published, so it stays out of the repository.
/.cache/

# Impeccable is installed per machine (`npx impeccable@4.8.0` or the Qoder
# skill); the repo keeps only its shared config. Vendoring the 2 MB skill and
# its 17 MB engine would drift from the version CI pins.
.qoder/skills/impeccable/
.impeccable/config.local.json
.impeccable/review/
.impeccable/live/
.impeccable/*.png
